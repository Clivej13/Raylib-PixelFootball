<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="Raylib-cs" Version="8.0.0" />
    <PackageReference Include="RaylibGameFramework.Configuration" Version="0.1.1" />
    <PackageReference Include="RaylibGameFramework.Input" Version="0.1.5" />
    <PackageReference Include="RaylibGameFramework.Menus" Version="0.1.3" />
    <ProjectReference Include="../RaylibGameFramework.Logging/RaylibGameFramework.Logging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="config.json;input.json;menu.json;logging.json;action_weights.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/Sprites/Players/**/*.png;Assets/Sprites/Field/**/*.png;Assets/Sprites/Ball/**/*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
